# Baucontainer für das Linux-Bündel (Fedora).
#
#   docker build --platform linux/amd64 -f packaging/linux/Dockerfile.fedora -t qslcards-build .
#   docker run --rm --platform linux/amd64 \
#              --user "$(id -u):$(id -g)" -v "$PWD:/src" qslcards-build
#
# `--platform linux/amd64` ist auf Apple Silicon nötig: ohne die Angabe entsteht
# ein aarch64-Programm, das auf keinem üblichen Fedora-PC läuft. Die Emulation
# macht den Lauf spürbar langsam, aber das Ergebnis ist richtig.
#
# `--user` ist keine Kür: ohne die Angabe baut der Container als root, und
# `dist/`, `build/` und `qslcards.egg-info/` gehören hinterher root im Repo des
# Anwenders — vom Mac aus ließen sie sich nicht einmal mehr löschen.
#
# Mit podman derselbe Aufruf ohne `--user` (podman bildet den Benutzer von sich
# aus ab), dafür mit `:z` an der Einhängung: `-v "$PWD:/src:z"` (SELinux).
#
# Warum ein Container und nicht einfach „irgendein Linux": PyInstaller bündelt
# keine glibc. Ein Programm läuft nur auf Systemen, deren glibc mindestens so
# neu ist wie die des Baurechners. Gebaut wird deshalb auf der ältesten
# Fedora-Version, die unterstützt werden soll — F42 (glibc 2.41).
#
# `fedora` ist das offizielle Abbild von Docker Hub (Docker Official Image).
FROM fedora:42

# **Nicht `python3`, sondern `python3.14`** — und das ist der ganze Trick an
# dieser Datei. Fedora 42 hat Tcl/Tk 9.0 zwar als Systempaket (`tk` = 9.0.0),
# aber sein Standard-Python ist 3.13 und dessen `python3-tkinter` ist gegen die
# **Kompatibilitätspakete** `tcl8`/`tk8` gebaut: `tkinter.TkVersion` meldet dort
# 8.6. Damit fehlten der Vorschautabelle stillschweigend die Stift- und
# Schalter-Symbole (`gui/preview.py` fängt den Fehler ab) — genau der Fall, den
# `scripts/build_app.py` verhindern soll; es bräche den Build mit „Tk 8.6 statt
# 9.0+" ab. Nachgeprüft mit `dnf repoquery --requires`:
#
#   python3-tkinter    (3.13) -> libtcl8.6.so    libtk8.6.so
#   python3.14-tkinter (3.14) -> libtcl9.0.so    libtcl9tk9.0.so
#
# Fedora 42 liefert 3.14 als Parallel-Interpreter mit, gegen Tcl/Tk 9 gebaut.
# Der Umweg über Fedora 43 (dessen Standard-Python 3.14 ist) wäre die Alternative
# gewesen und wurde verworfen: dessen glibc 2.42 ist neuer, das fertige Programm
# liefe dann nicht mehr auf Fedora 42.
#
# `info library` liefert hier einen echten Ordner (`/usr/share/tcl9.0`), keinen
# eingebetteten `//zipfs:/`-Pfad wie der Windows-Installer — das veröffentlichte
# PyInstaller 6.21.0 genügt also, die `develop`-Fassung ist nur unter Windows nötig.
#
# tkinter ist auf Fedora ein eigenes Paket und fehlt sonst still — PyInstaller
# baut dann ein Programm, das beim Start kein tkinter findet.
# binutils braucht PyInstaller für die Abhängigkeitsanalyse (objdump).
RUN dnf -y install --setopt=install_weak_deps=False \
        python3.14 python3.14-tkinter \
        binutils tar gzip findutils \
    && dnf clean all

# Die virtuelle Umgebung wird ins Abbild gebaut, nicht bei jedem Lauf: sonst
# lädt jeder Durchgang die Abhängigkeiten neu — über die Emulation dauert das
# länger als der Build selbst. `--user` beim Lauf darf sie nur lesen können.
COPY pyproject.toml README.md /build/
COPY qslcards/__init__.py /build/qslcards/__init__.py
RUN python3.14 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir /build[build] \
    && /opt/venv/bin/pip uninstall -y qslcards \
    && rm -rf /build \
    && chmod -R a+rX /opt/venv

# Der Quellbaum kommt beim Lauf herein, nicht ins Abbild: derselbe Container
# baut jeden Stand, ohne neu gebaut zu werden. `qslcards` selbst wird nicht
# installiert — die Spec legt die Projektwurzel auf den Suchpfad.
WORKDIR /src
ENV HOME=/tmp
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
CMD ["/opt/venv/bin/python", "scripts/build_app.py", "--clean"]
