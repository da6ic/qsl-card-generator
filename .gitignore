# Konfiguration & lokale Daten (nicht einchecken)
config.yaml
lookup_cache.json
*.png

# Ausnahme: das Programm-Icon gehört zum Code (aus app_icon.svg gerendert,
# siehe scripts/make_icon.py) und muss mit eingecheckt werden.
!qslcards/assets/icons/*.png

# ADIF-Logbücher (lokale/persönliche Daten)
*.adi
*.adif

# Ausgabe
/output/
*.pdf
*_addresses.csv

# Python
__pycache__/
*.pyc
*.egg-info/

# Bündeln (PyInstaller + fertige Archive)
/build/
/dist/

# Virtuelle Umgebungen: `.venv` zum Entwickeln, `.venv-build` zum Bündeln
# (so heißt sie in packaging/windows/build.ps1). Beide bleiben draußen.
# `.venv-build` blieb bisher nur deshalb unsichtbar, weil `venv` sich selbst
# eine `.gitignore` mit `*` hineinschreibt — darauf sollte sich niemand
# verlassen müssen.
.venv/
.venv-build/

# IDE / OS / Werkzeuge
.idea/
.DS_Store
# Vom `/ide`-Befehl der Entwicklungswerkzeuge angelegt — lokale Verbindungsdaten,
# nichts Projekthaftes. Bleibt draußen, sonst bricht `scripts/release.py` mit
# „Arbeitskopie ist nicht sauber" ab.
.mcp.json