# Konfiguration & lokale Daten (nicht einchecken)
config.yaml
lookup_cache.json
# GDXF-Most-Wanted-Rangliste, vom Programm abgerufen (fremde Daten, nicht einchecken)
mostwanted.json
# In Wavelog als „Papier-QSL gesendet" markierte QSO-IDs (lokale Daten)
wavelog_sent.json
# Zuletzt geladene cty.dat im Projektordner (die mitgelieferte liegt in qslcards/assets/dxcc/)
/cty.dat
*.png

# Ausnahme: das Programm-Icon gehört zum Code (aus app_icon.svg gerendert,
# siehe scripts/make_icon.py) und muss mit eingecheckt werden.
!qslcards/assets/icons/*.png

# ADIF-Logbücher (lokale/persönliche Daten)
*.adi
*.adif

# Ausgabe
/output/
*.pdf
*_addresses.csv

# Python
__pycache__/
*.pyc
*.egg-info/

# Bündeln (PyInstaller + fertige Archive)
/build/
/dist/

# Virtuelle Umgebungen: `.venv` zum Entwickeln, `.venv-build` zum Bündeln
# (so heißt sie in packaging/windows/build.ps1). Beide bleiben draußen.
# `.venv-build` blieb bisher nur deshalb unsichtbar, weil `venv` sich selbst
# eine `.gitignore` mit `*` hineinschreibt — darauf sollte sich niemand
# verlassen müssen.
.venv/
.venv-build/

# IDE / OS / Werkzeuge
.idea/
.DS_Store
# Vom `/ide`-Befehl der Entwicklungswerkzeuge angelegt — lokale Verbindungsdaten,
# nichts Projekthaftes. Bleibt draußen, sonst bricht `scripts/release.py` mit
# „Arbeitskopie ist nicht sauber" ab.
.mcp.json

# Lokale Einstellungen von Claude Code (Berechtigungen dieses Rechners).
.claude/settings.local.json

# Beispiel-Logs: echte Contest-Logs mit Name, Anschrift und E-Mail im Kopf —
# persönliche Daten, gehören nicht ins Repository. Der Abgleich in
# tests/test_dxcc.py läuft nur, wenn sie lokal da sind.
/beispiel-logs/

# „DXCC-Filter" eines Vereinskollegen: eigenes Programm, eigenes Repository.
# Liegt hier nur zum Nachschlagen; übernommen sind Regeln und Nummerntabelle
# (siehe qslcards/dxcc/).
/dxcc-filter/
